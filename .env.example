# Environment Configuration
NODE_ENV=development
PORT=5000

# Security
JWT_SECRET=shardsafe-secret-key-change-this-in-production-vault-9921
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL on Amazon RDS or local)
# Leave empty to use local persistent dev engine during offline testing
DATABASE_URL=postgresql://shardsafe_user:your_secure_password@shardsafe-db.cxxxx.ap-south-1.rds.amazonaws.com:5432/shardsafe

# AWS Region & S3 Buckets
AWS_REGION=ap-south-1
S3_VAULT_BUCKET=shardsafe-vault-ap-south-1-123456789012
S3_DOCS_BUCKET=shardsafe-docs-ap-south-1-123456789012

# Storage Provider: 's3' for real Amazon S3, or 'local' for offline local dev mode
STORAGE_PROVIDER=local

# CORS & Origin settings
FRONTEND_ORIGIN=http://localhost:5173

# File Vault Limits
MAX_FILE_SIZE_MB=50
CHUNK_SIZE_BYTES=1048576
PRESIGNED_URL_EXPIRES_SECONDS=900
